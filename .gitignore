# Asset meta files are only ignored when their asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE and OS files
.vs/
.vscode/
.idea/
.gradle/
